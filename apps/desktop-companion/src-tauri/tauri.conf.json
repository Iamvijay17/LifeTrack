{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeTrack Companion",
  "version": "0.1.0",
  "identifier": "app.lifetrack.companion",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      {
        "label": "companion",
