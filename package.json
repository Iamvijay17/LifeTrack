{
  "name": "lifetrack-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @lifetrack/web dev",
    "build": "pnpm --filter @lifetrack/web build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @lifetrack/web test:e2e",
    "test:sql": "node scripts/verify-sql.mjs",
    "test:rls": "pnpm --filter @lifetrack/db-tests test",
    "test:pg": "pnpm --filter @lifetrack/db-tests exec vitest run postgres",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "sql:build": "node scripts/build-setup-sql.mjs",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:sql-drift": "node scripts/build-setup-sql.mjs && git diff --exit-code -- supabase/setup-all.sql",
    "test:rn": "pnpm --filter @lifetrack/mobile test:rn",
    "verify": "pnpm typecheck && pnpm check:secrets && pnpm test:coverage && pnpm test:rn && pnpm test:rls && pnpm test:sql && pnpm check:sql-drift && pnpm check:migrations",
    "check:migrations": "node scripts/check-migration-safety.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "^5.9.0"
  }
}
